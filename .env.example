# Development defaults. Copy to .env and replace secrets before deployment.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional production path; keep this directory outside any public web root.
# DJANGO_PRIVATE_MEDIA_ROOT=/srv/sportswear/private_media
# For production set DEBUG=False, use HTTPS, and configure trusted origins as needed.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# SQLite is the selected database for the current deployment. Use a persistent local disk,
# back it up consistently, and do not place the database on a network filesystem.
DB_ENGINE=sqlite
DB_NAME=sportswear.sqlite3
SQLITE_TIMEOUT=30
SQLITE_TRANSACTION_MODE=IMMEDIATE
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional email settings (password reset prints to the console by default).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@sportswear.local
